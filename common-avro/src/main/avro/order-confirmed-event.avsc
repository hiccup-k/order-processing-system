{
  "type": "record",
  "name": "OrderConfirmedEvent",
  "namespace": "com.example.events",
  "doc": "Published by order-service after it moves an order to CONFIRMED, consumed by notification-service.",
  "fields": [
    {"name": "eventId", "type": "string"},
    {"name": "orderId", "type": "long"},
    {"name": "customerId", "type": "string"},
    {"name": "status", "type": {"type": "enum", "name": "OrderStatusAvro", "symbols": ["CONFIRMED", "CANCELLED", "FAILED"]}},
    {"name": "confirmedAt", "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
